{
  "name": "beauty-lv",
  "private": true,
  "version": "0.0.0",
  "description": "Beauty.lv monorepo: Next.js web app + NestJS API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --config apps/web/eslint.config.mjs"
    ],
    "apps/api/**/*.ts": [
      "prettier --write",
      "eslint --fix --config apps/api/eslint.config.mjs"
    ],
    "packages/**/*.ts": [
      "prettier --write",
      "eslint --fix --config eslint.config.mjs"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
