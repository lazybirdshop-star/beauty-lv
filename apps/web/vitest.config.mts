import { fileURLToPath } from 'node:url';

import { defineConfig } from 'vitest/config';

/**
 * Unit-тесты веб-приложения (BRAND_STYLE_ARCHITECTURE.md §12, шаг M0).
 *
 * Образец — `packages/shared-kernel` (`vitest run`, без плагинов): тесты
 * ходят против чистых функций, поэтому среда — node, а не jsdom. Единственное
 * дополнение к дефолту — алиас `@/`, которым пользуется приложение Next.
 * Визуальные базлайны этим раннером не гоняются: для них —
 * `scripts/visual-baselines.mjs` (§16).
 */
export default defineConfig({
  resolve: {
    alias: {
      '@': fileURLToPath(new URL('./src', import.meta.url)),
    },
  },
  test: {
    environment: 'node',
    include: ['src/**/*.test.ts', 'src/**/*.test.tsx'],
    /*
     * Пояс прогона задан явно, и задан UTC.
     *
     * Без него тесты идут в поясе машины: у разработчика в Риге зелено, в CI
     * красно — и наоборот, — а разбирать такое приходится по логам сборки
     * вместо собственного экрана. UTC, а не «Europe/Riga»: в этом поясе живёт
     * сервер, на котором код в итоге и работает, и тест, который ломается
     * только в UTC, ломается там, где это дороже всего.
     *
     * Всё, что должно считаться в поясе салона, обязано называть его явным
     * аргументом (см. `format.ts` и `civil-date.ts`). Этот параметр — не
     * замена такому аргументу, а способ поймать место, где его забыли.
     */
    env: { TZ: 'UTC' },
  },
});