NODE_ENV=development
PORT=3001

# Local Postgres from docker-compose. In production this is the hosted
# database — for Supabase use the Session pooler string for the running app
# and the Direct connection string for `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amolie

# Optional. Nothing connects to Redis yet; set it once rate-limit counters or
# the slot soft-hold move off in-process memory (TASKS.md A-5, B-11).
# REDIS_URL=redis://localhost:6379

# Must both be set explicitly in production, at least 32 characters, and
# different from each other — the API refuses to boot otherwise.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Object storage for page images (master photo, hero, background). Without
# these the API still runs — only image upload answers 503. The service role
# key is a full-access credential: API only, never in the browser bundle.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MEDIA_BUCKET=page-media

# Web Push (VAPID) — push notifications to the master about a new booking.
# Generate the pair once, for the whole product:
#   pnpm --filter @amolie/api exec web-push generate-vapid-keys
# Changing it invalidates every existing subscription: a device subscribed
# under the old public key and will not accept messages signed by a new one.
# Without these the API still runs — the dashboard says notifications are not
# available and no booking is affected. The private key never leaves the
# server; the public one is handed to browsers by design.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for the push service, must be a mailto: or https: URI (Apple rejects
# anything else). Defaults to https://amolie.com.
# VAPID_SUBJECT=https://amolie.com
